# Spring Boot Profile (dev, prod)
PROFILE=
SERVER_PORT=

# Redis
# 기본값은 redis://localhost:6379 입니다.
# 로컬 예시: REDIS_URL=redis://localhost:6379
# AWS ElastiCache TLS + ACL 예시: REDIS_URL=rediss://username:password@elasticache-endpoint:6379
REDIS_URL=

# JWT Secret Key
# Base64 인코딩된 키를 사용해야 합니다.
JWT_KEY=

# --- Development Environment ---
# Dev DB
DEV_DB_URL=
DEV_DB_USERNAME=
DEV_DB_PASSWORD=
DEV_DB_DDL_AUTO=
DEV_DB_SHOW_SQL=
DEV_DB_FORMAT_SQL=
DEV_DB_USE_SQL_COMMENTS=

# --- Production Environment ---
# Prod DB
PROD_DB_URL=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# --- Common Services ---
# Storage (MinIO)
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Email (Gmail SMTP)
SUPPORT_EMAIL=
EMAIL_PWD=

# Google Services (Firebase, Gemini)
# GOOGLE_APPLICATION_CREDENTIALS는 파일 경로입니다.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-key.json
GEMINI_API_KEY=your_gemini_api_key

# Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Monitoring - Allowed IPs for /actuator endpoints
# Docker 네트워크 대역 (기본값: 172.18.0.0/16)
# 여러 IP는 쉼표로 구분: 172.18.0.0/16,192.168.1.100
MONITORING_ALLOWED_IPS=172.18.0.0/16,192.168.0.0/16
# MySQL host port (dev default: 9915, prod default: 9914)
DB_PORT=

# Email (Mailpit) dev mode
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
